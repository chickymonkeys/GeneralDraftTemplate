% Portable cross-document labels and bibliography paths for root proxies.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{gdt-build}[2026/10/02 Cross-document references]
\RequirePackage{xr}

% Read literal lines instead of executing arbitrary definitions. The same
% line grammar is used by latexmkrc, including for direct pdfLaTeX builds.
\ExplSyntaxOn
\ior_new:N \l_gdt_names_ior
\prop_new:N \l_gdt_names_prop
\seq_new:N \l_gdt_names_match_seq
\seq_new:N \l_gdt_names_seen_seq
\tl_new:N \l_gdt_names_line_tl
\tl_new:N \l_gdt_names_role_tl
\tl_new:N \l_gdt_names_base_tl
\msg_new:nnn {gdt} {names} {Invalid~gdt-names.tex:~#1.\MessageBreak See~docs/building.md;~use~three~literal~basename~definitions.}
\file_if_exist:nF {gdt-names.tex}
  {\msg_fatal:nnn {gdt} {names} {file~missing}}
\ior_open:Nn \l_gdt_names_ior {gdt-names.tex}
\ior_str_map_inline:Nn \l_gdt_names_ior
  {
    \tl_set:Nn \l_gdt_names_line_tl {#1}
    \regex_replace_once:nnN {\%.*} {} \l_gdt_names_line_tl
    \regex_replace_all:nnN {\A\s+|\s+\Z} {} \l_gdt_names_line_tl
    \tl_if_empty:NF \l_gdt_names_line_tl
      {
        \regex_extract_once:nVNTF
          {\A \\def\\GDT(Main|Appendix|Combined)Base\{([A-Za-z0-9](?:[A-Za-z0-9_.\-]*[A-Za-z0-9_\-])?)\} \Z}
          \l_gdt_names_line_tl \l_gdt_names_match_seq
          {
            \tl_set:Nx \l_gdt_names_role_tl {\seq_item:Nn \l_gdt_names_match_seq {2}}
            \tl_set:Nx \l_gdt_names_base_tl {\seq_item:Nn \l_gdt_names_match_seq {3}}
            \exp_args:NNV \prop_if_in:NnT \l_gdt_names_prop \l_gdt_names_role_tl
              {\msg_fatal:nnn {gdt} {names} {duplicate~role}}
            \tl_set:Nx \l_tmpa_tl {\str_lowercase:f {\l_gdt_names_base_tl}}
            \exp_args:NNV \seq_if_in:NnT \l_gdt_names_seen_seq \l_tmpa_tl
              {\msg_fatal:nnn {gdt} {names} {case-insensitive~basename~collision}}
            \seq_put_right:NV \l_gdt_names_seen_seq \l_tmpa_tl
            \prop_put:NVV \l_gdt_names_prop \l_gdt_names_role_tl \l_gdt_names_base_tl
            \cs_gset:cpx {GDT\l_gdt_names_role_tl Base} {\l_gdt_names_base_tl}
          }
          {\msg_fatal:nnn {gdt} {names} {malformed~line~or~unsupported~basename}}
      }
  }
\ior_close:N \l_gdt_names_ior
\clist_map_inline:nn {Main,Appendix,Combined}
  {
    \prop_if_in:NnF \l_gdt_names_prop {#1}
      {\msg_fatal:nnn {gdt} {names} {missing~GDT#1Base}}
  }
% latexmkrc makes each pass depend on the companion's sources. TeX does not
% open them, so this document's recorder file lists only what it reads.
% \GDTTrackDocument does nothing; it remains for combined roots written for
% earlier versions of the template.
\newcommand{\GDTTrackDocument}[1]{}
\ExplSyntaxOff

% The imported draft keeps its existing ../references path. Biber resolves
% resource paths relative to the root target instead, hence the prefix.
\ifdefined\GDTBibliographyBase
  \let\GDTOriginalAddBibResource\addbibresource
  \renewcommand{\addbibresource}[2][]{%
    \GDTOriginalAddBibResource[#1]{\GDTBibliographyBase#2}%
  }
\fi

% Import the other document's labels. The first argument, its source, is no
% longer read and remains for compatibility. Labels use root target names.
\newcommand{\GDTExternalDocument}[2]{\externaldocument[][nocite]{#2}}
\newcommand{\GDTMainDocument}{\GDTExternalDocument{\GDTMainBase.tex}{\GDTMainBase}}
\newcommand{\GDTAppendixDocument}{\GDTExternalDocument{\GDTAppendixBase.tex}{\GDTAppendixBase}}
